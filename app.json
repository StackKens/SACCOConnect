{
  "expo": {
    "name": "SACCOConnect",
    "slug": "saccoconnect",
    "version": "1.0.0",
    "scheme": "saccoconnect",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets//logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.saccoconnect.app"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.saccoconnect.app"
    }
  }
}
