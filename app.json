{
  "expo": {
    "name": "SACCOConnect",
    "slug": "saccoconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saccoconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A2540"
      },
      "package": "com.saccoconnect.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "scheme": "saccoconnect",
    "router": {
      "ignoredRouteFiles": ["**/src/**"]
    },
    "extra": {
      "apiUrl": "https://saccoconnect-production.up.railway.app"
    }
  }
}
