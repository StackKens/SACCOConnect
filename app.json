{
  "expo": {
    "name": "SACCOConnect",
    "slug": "saccoconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.jpeg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saccoconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.jpeg",
        "backgroundColor": "#0A2540"
      },
      "package": "com.saccoconnect.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ],
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidSizeOptimization"
    ],
    "scheme": "saccoconnect",
    "router": {
      "ignoredRouteFiles": [
        "**/src/**"
      ]
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:3000"
    }
  }
}
