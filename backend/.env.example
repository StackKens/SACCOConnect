# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (local dev, Docker, or Neon/Railway)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/saccoconnect"
PORT=3000
NODE_ENV=development

# REQUIRED in production — the app refuses to start without these.
# Generate with: openssl rand -base64 48  (each must be >= 32 chars, unique)
JWT_ACCESS_SECRET="generate-me-with-openssl-rand-base64-48"
JWT_REFRESH_SECRET="generate-me-another-openssl-rand-base64-48"
JWT_REFRESH_EXPIRES_IN="30d"
# Access tokens are short-lived (default 1h). Use e.g. "15m" for stricter limits.
JWT_ACCESS_TTL="1h"

# Behavioral security intelligence engine (separate service). Optional —
# if unreachable the API continues without risk intelligence.
SECURITY_ENGINE_URL="http://localhost:8000"
SECURITY_ENGINE_TIMEOUT_MS="2000"

# Enforce the engine's risk verdict on login: block when risk is at/above
# SECURITY_RISK_BLOCK_LEVELS. Set to "false" to only log, never block.
# NOTE: the current bundle is trained on synthetic data, so legit new
# users/devices are often flagged HIGH until the model sees real traffic.
SECURITY_RISK_ENFORCE="true"
SECURITY_RISK_BLOCK_LEVELS="high,critical"

# Optional — OTP prints to console in development without Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
