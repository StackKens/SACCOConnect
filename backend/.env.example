# Local dev (SQLite — no Postgres required)
DATABASE_URL="file:./prisma/dev.db"
PORT=3000
NODE_ENV=development

JWT_SECRET="dev-jwt-secret-minimum-32-characters-long"
JWT_REFRESH_SECRET="dev-refresh-secret-minimum-32-chars"

# Optional — OTP prints to console in development without Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
