# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (local dev, Docker, or Neon/Railway)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/saccoconnect"
PORT=3000
NODE_ENV=development

# REQUIRED in production — the app refuses to start without these.
# Generate with: openssl rand -base64 48  (each must be >= 32 chars, unique)
JWT_ACCESS_SECRET="generate-me-with-openssl-rand-base64-48"
JWT_REFRESH_SECRET="generate-me-another-openssl-rand-base64-48"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_EXPIRES_IN="7d"

# Optional — OTP prints to console in development without Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
